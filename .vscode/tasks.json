{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MkDocs: Serve",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "mkdocs", "serve", "-a", "127.0.0.1:8000"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "MkDocs: Build (strict)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "mkdocs", "build", "--strict"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Privacy check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/check_privacy.py"],
      "dependsOn": "MkDocs: Build (strict)",
      "problemMatcher": []
    },
    {
      "label": "Link check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/check_links.py", "site"],
      "dependsOn": "MkDocs: Build (strict)",
      "problemMatcher": []
    },
    {
      "label": "Install deps",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    }
  ]
}
